{
  "name": "lottie-constructor",
  "version": "1.0.0",
  "author": "abdelaziz-elshrkawy",
  "main": "command.js",
  "scripts": {
    "start": "node ./command.js",
    "build": "pkg . --targets node18-win-x64,node18-macos-x64,node18-linux-x64"
  },
  "bin": {
    "lottie-constructor": "./command.js"
  },
  "keywords": [
